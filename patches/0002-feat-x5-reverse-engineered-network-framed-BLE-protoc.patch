+func TestEncodeNetMessageRoundTrip(t *testing.T) {
+	body := []byte{0x08, 0x01}
+	frame := EncodeNetMessage(0x10, 42, body)
+
+	payload, _, err := DecodeNetFrame(frame)
+	require.NoError(t, err)
+
+	msg, err := ParseNetMessage(payload)
+	require.NoError(t, err)
